    INTO v_target_index_count
    FROM pg_index
    WHERE indrelid = 'public.kpi_data_refresss'::regclass;

    SELECT COUNT(*)
    INTO v_shadow_index_count
    FROM pg_index
    WHERE indrelid = 'public.kpi_data_refresss_shadow'::regclass;

    IF v_target_index_count <> v_shadow_index_count THEN
        RAISE EXCEPTION
        'Index count mismatch. Target: %, Shadow: %',
        v_target_index_count, v_shadow_index_count;
    END IF;

    -- Compare index definitions
    IF EXISTS (
        WITH target_indexes AS (
            SELECT
                am.amname,
                i.indisunique,
                i.indisprimary,
                i.indisexclusion,
                i.indimmediate,
                i.indisvalid,
                i.indisready,
                i.indnatts,
                i.indkey::text AS indkey,
                i.indclass::text AS indclass,
                i.indcollation::text AS indcollation,
                i.indoption::text AS indoption,
                pg_get_expr(i.indpred, i.indrelid) AS predicate,
                pg_get_expr(i.indexprs, i.indrelid) AS expressions
            FROM pg_index i
            JOIN pg_class idx
                ON idx.oid = i.indexrelid
            JOIN pg_am am
                ON am.oid = idx.relam
            WHERE i.indrelid =
                'public.kpi_data_refresss'::regclass
        ),
        shadow_indexes AS (
            SELECT
                am.amname,
                i.indisunique,
                i.indisprimary,
                i.indisexclusion,
                i.indimmediate,
                i.indisvalid,
                i.indisready,
                i.indnatts,
                i.indkey::text AS indkey,
                i.indclass::text AS indclass,
                i.indcollation::text AS indcollation,
                i.indoption::text AS indoption,
                pg_get_expr(i.indpred, i.indrelid) AS predicate,
                pg_get_expr(i.indexprs, i.indrelid) AS expressions
            FROM pg_index i
            JOIN pg_class idx
                ON idx.oid = i.indexrelid
            JOIN pg_am am
                ON am.oid = idx.relam
            WHERE i.indrelid =
                'public.kpi_data_refresss_shadow'::regclass
        )
        SELECT 1
        FROM (
            (
                SELECT * FROM target_indexes
                EXCEPT ALL
                SELECT * FROM shadow_indexes
            )
            UNION ALL
            (
                SELECT * FROM shadow_indexes
                EXCEPT ALL
                SELECT * FROM target_indexes
            )
        ) differences
        LIMIT 1
    ) THEN
        RAISE EXCEPTION
        'Index definition mismatch between target and shadow table.';
    END IF;

    RAISE NOTICE
    'Index validation successful. Total indexes: %',
    v_shadow_index_count;

    -- 12. Dynamically copy existing RLS policies

    FOR r_policy IN
        SELECT *
        FROM pg_policies
        WHERE schemaname = 'public'
          AND tablename = 'kpi_data_refresss'
    LOOP

        SELECT string_agg(
            CASE
                WHEN role_name = 'public' THEN 'PUBLIC'
                ELSE quote_ident(role_name::text)
            END,
            ', '
        )
        INTO v_roles
        FROM unnest(r_policy.roles) AS role_name;

        v_sql := format(
            'CREATE POLICY %I
             ON public.kpi_data_refresss_shadow
             AS %s
             FOR %s
             TO %s',
            r_policy.policyname,
            r_policy.permissive,
            r_policy.cmd,
            v_roles
        );

        IF r_policy.qual IS NOT NULL THEN
            v_sql := v_sql || format(
                ' USING (%s)',
                r_policy.qual
            );
        END IF;

        IF r_policy.with_check IS NOT NULL THEN
            v_sql := v_sql || format(
                ' WITH CHECK (%s)',
                r_policy.with_check
            );
        END IF;

        EXECUTE v_sql;

    END LOOP;

    -- 13. Apply existing RLS settings

    IF v_rls_enabled THEN
        ALTER TABLE public.kpi_data_refresss_shadow
        ENABLE ROW LEVEL SECURITY;
    END IF;

    IF v_rls_forced THEN
        ALTER TABLE public.kpi_data_refresss_shadow
        FORCE ROW LEVEL SECURITY;
    END IF;

    -- 14. Copy existing table permissions

    FOR r_acl IN
        SELECT
            acl.grantee,
            acl.privilege_type,
            acl.is_grantable
        FROM pg_class c
        CROSS JOIN LATERAL
            aclexplode(
                COALESCE(
                    c.relacl,
                    acldefault('r', c.relowner)
                )
            ) AS acl
        WHERE c.oid = 'public.kpi_data_refresss'::regclass
    LOOP

        v_roles := CASE
            WHEN r_acl.grantee = 0 THEN 'PUBLIC'
            ELSE quote_ident(
                pg_get_userbyid(r_acl.grantee)
            )
        END;

        v_sql := format(
            'GRANT %s ON TABLE public.kpi_data_refresss_shadow TO %s%s',
            r_acl.privilege_type,
            v_roles,
            CASE
                WHEN r_acl.is_grantable
                THEN ' WITH GRANT OPTION'
                ELSE ''
            END
        );

        EXECUTE v_sql;

    END LOOP;

    -- 15. Preserve existing table owner

    EXECUTE format(
        'ALTER TABLE public.kpi_data_refresss_shadow OWNER TO %I',
        v_owner
    );

    -- 16. Atomic table replacement

    ALTER TABLE public.kpi_data_refresss
    RENAME TO kpi_data_refresss_old;

    ALTER TABLE public.kpi_data_refresss_shadow
    RENAME TO kpi_data_refresss;

    -- 17. Remove old target table

    DROP TABLE public.kpi_data_refresss_old;

    RAISE NOTICE
    'KPI refresh successful. Records: %, Indexes: %, RLS policies copied.',
    v_inserted_count,
    v_shadow_index_count;

END;
$$;

