WITH base AS (
    SELECT
        region,
        attributes,
        `values` AS value,
        CASE
            WHEN RIGHT(attributes, 2) = '_1'
                THEN LEFT(attributes, LENGTH(attributes) - 2)
            ELSE attributes
        END AS base_attribute
    FROM pivote_df
),

paired AS (
    SELECT
        region,
        base_attribute,
        MAX(
            CASE
                WHEN attributes = base_attribute
                THEN value
            END
        ) AS original_value
    FROM base
    GROUP BY region, base_attribute
)

SELECT
    b.region,
    b.attributes,
    b.value AS `values`
FROM base b
LEFT JOIN paired p
    ON b.region = p.region
    AND b.base_attribute = p.base_attribute
WHERE
    -- Keep original attribute only when its value is NOT NULL
    (b.attributes = b.base_attribute AND p.original_value IS NOT NULL)

    OR

    -- Always keep the _1 record
    RIGHT(b.attributes, 2) = '_1';
