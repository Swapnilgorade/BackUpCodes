WITH base AS (
    SELECT
        region,
        attributes,
        `values` AS value,
        CASE
            WHEN attributes LIKE '%\_1' ESCAPE '\\'
            THEN LEFT(attributes, LENGTH(attributes) - 2)
            ELSE attributes
        END AS base_attribute
    FROM pivote_df
),

paired AS (
    SELECT
        region,
        base_attribute,

        MAX(
            CASE
                WHEN attributes = base_attribute
                THEN value
            END
        ) AS original_value,

        MAX(
            CASE
                WHEN attributes = CONCAT(base_attribute, '_1')
                THEN value
            END
        ) AS suffixed_value

    FROM base
    GROUP BY region, base_attribute
)

SELECT
    region,
    CASE
        WHEN original_value IS NOT NULL
        THEN CONCAT(base_attribute, '_1')
        ELSE base_attribute
    END AS attributes,

    CASE
        WHEN original_value IS NOT NULL
        THEN suffixed_value
        ELSE original_value
    END AS `values`

FROM paired
WHERE
    original_value IS NOT NULL
    OR suffixed_value IS NOT NULL;
